# ===========================================
# 前端环境变量配置示例
# ===========================================
# 使用说明：
# 1. 复制此文件并重命名为 .env.local 或 .env
# 2. 根据实际情况修改配置值
# 3. .env.local 文件不会被 Git 追踪
# ===========================================

# ------------------------------------------
# API 配置
# ------------------------------------------
# 后端 API 地址（必填）
VITE_API_URL=http://localhost:3000/api

# ------------------------------------------
# Mock 模式配置
# ------------------------------------------
# 是否启用 Mock 数据模式（true/false）
# 启用后将使用本地模拟数据，无需后端服务
VITE_USE_MOCK=false

# ------------------------------------------
# 微信登录配置
# ------------------------------------------
# 是否启用微信登录功能（true/false）
# 需要后端配置 WECHAT_APP_ID 和 WECHAT_APP_SECRET
VITE_ENABLE_WECHAT_LOGIN=false

# ------------------------------------------
# 应用配置
# ------------------------------------------
# 应用标题（可选，默认使用 project.config.tsx 中的配置）
# VITE_APP_TITLE=B端底座系统

# 默认语言（可选，zh/en）
# VITE_DEFAULT_LOCALE=zh

# ------------------------------------------
# 开发配置
# ------------------------------------------
# 开发服务器端口（可选，默认 5173）
# VITE_DEV_PORT=5173

# 是否启用严格模式（可选，默认 true）
# VITE_STRICT_MODE=true

generator client {
  provider = "prisma-client-js"
}

datasource db {

model Empty {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empty")
}

model ExistingModel {
  id        Int      @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("existing_model")
}

model TestModel {
  id        Int      @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("test_model")
}

model TestResource {
  id        Int      @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("test-resource")
}
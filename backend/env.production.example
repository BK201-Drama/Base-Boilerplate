# 生产环境配置示例（请复制为 .env 并填真实值）

# 数据库配置
DATABASE_URL="postgresql://user:password@db-host:5432/base_boilerplate?schema=public"

# JWT 配置（至少 32 位高强度随机字符串）
JWT_SECRET=replace-with-a-strong-secret-min-32-chars
JWT_EXPIRES_IN=7d

# 应用配置
PORT=3000
NODE_ENV=production

# CORS 白名单，多个域名用英文逗号分隔
# 例如：https://admin.example.com,https://ops.example.com
CORS_ORIGINS=https://admin.example.com

# 微信登录配置（如不用可留空）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

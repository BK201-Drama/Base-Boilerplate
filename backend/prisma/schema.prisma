generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatusEnum {
  active
  inactive
  banned
}

model RolePermission {
  id     Int  @id @default(autoincrement())
  permissionId Int
  roleId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([permissionId, roleId])

  @@map("role_permissions")
}
model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])

  @@map("user_roles")
}

// 操作日志
model OperationLog {
  id        Int      @id @default(autoincrement())
  // HTTP 方法
  method String
  // 请求路径
  path String
  // 请求参数（JSON）
  params String? @db.Text
  // 响应数据（JSON）
  response String? @db.Text
  // HTTP 状态码
  statusCode Int
  // IP 地址
  ip String?
  // User Agent
  userAgent String?
  // 请求耗时（毫秒）
  duration Int?
  // 用户ID
  userId Int
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([userId])

  @@map("operation_logs")
}

// 权限资源（RBAC系统）
model Permission {
  id        Int      @id @default(autoincrement())
  // 权限名称
  name String @unique
  // 权限代码
  code String @unique
  // 资源名称
  resource String
  // 操作类型
  action String
  // 权限描述
  description String? @db.Text
  roles Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// 角色资源（RBAC系统）
model Role {
  id        Int      @id @default(autoincrement())
  // 角色名称
  name String @unique
  // 角色代码
  code String @unique
  // 角色描述
  description String? @db.Text
  permissions Permission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// 用户资源（RBAC系统）
model User {
  id        Int      @id @default(autoincrement())
  // 用户名
  username String @unique
  // 邮箱
  email String @unique
  // 密码
  password String
  // 昵称
  nickname String?
  // 头像URL
  avatar String?
  // 用户状态
  status UserStatusEnum @default(active)
  roles Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

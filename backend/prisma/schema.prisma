generator client {
  provider = "prisma-client-js"
}

datasource db {

enum UserStatusEnum {
    active
  inactive
  banned
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model OperationLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  method      String   // HTTP 方法
  path        String   // 请求路径
  params      String?  @db.Text // 请求参数（JSON）
  response    String?  @db.Text // 响应数据（JSON）
  statusCode  Int      // HTTP 状态码
  ip          String?
  userAgent   String?
  duration    Int?     // 请求耗时（毫秒）
  createdAt   DateTime @default(now())

  @@map("operation_logs")
  @@index([userId])
  @@index([createdAt])
}

model Permission {
  id        String   @id @default(uuid())
  // 权限名称
  name String @unique
  // 权限代码
  code String @unique
  // 资源名称
  resource String
  // 操作类型
  action String
  // 权限描述
  description String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permission")
}

model Role {
  id        String   @id @default(uuid())
  // 角色名称
  name String @unique
  // 角色代码
  code String @unique
  // 角色描述
  description String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions Permission[]

  @@map("role")
}

model User {
  id        String   @id @default(uuid())
  // 用户名
  username String @unique
  // 邮箱
  email String @unique
  // 密码
  password String
  // 昵称
  nickname String?
  // 头像URL
  avatar String?
  // 用户状态
  status UserStatusEnum @default(active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles Role[]

  @@map("user")
}
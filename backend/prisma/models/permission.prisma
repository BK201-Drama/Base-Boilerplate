// 权限资源（RBAC系统）
model Permission {
  id        String   @id @default(uuid())
  // 权限名称
  name String @unique
  // 权限代码
  code String @unique
  // 资源名称
  resource String
  // 操作类型
  action String
  // 权限描述
  description String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permission")
}

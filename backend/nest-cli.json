{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "i18n/**/*",
        "outDir": "dist"
      }
    ],
    "watchAssets": true,
    "skipLibCheck": true
  },
  "exclude": [
    "**/*.template.ts",
    "**/templates/**"
  ]
}
